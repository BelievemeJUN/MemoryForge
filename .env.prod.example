# ===== CodeMind 生产密钥模板（P0-F-1）=====
# 用法：cp .env.prod.example .env.prod 后填入真实值。
# 安全要求：
#   - .env.prod 已在 .gitignore，严禁提交 git
#   - 生产环境的密钥与开发 .env 分离，定期轮换
#
# ===== 大模型 =====
# DeepSeek API Key（必填）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# DeepSeek 官方 OpenAI 兼容地址
BASE_URL=https://api.deepseek.com

# 主模型
AGENT_BASE_MODEL=deepseek-chat

# ===== 模型路由（P2，成本优化）=====
# 简单任务走 SIMPLE_MODEL（便宜快），复杂任务走 COMPLEX_MODEL（强）
# SIMPLE_MODEL=deepseek-chat
# COMPLEX_MODEL=deepseek-chat   # 可切 deepseek-reasoner（更强更贵）

# ===== 认证（A-1）=====
# 格式: key:user_id,key:user_id。生产应接用户表/JWT 动态签发
API_KEYS=prodkey1:42,prodkey2:7

# ===== 多租户配额（A-2，可选）=====
# QUOTA_USER_<user_id>_MEM / _PIDS / _CPU / _TIMEOUT 覆盖默认配额
# 例：QUOTA_USER_42_MEM=128m
QUOTA_USER_42_MEM=128m
QUOTA_USER_42_PIDS=32

# ===== PostgreSQL =====
# 两处密码必须一致：
#   - postgres 服务的 POSTGRES_PASSWORD 放**根目录 .env**（compose 插值用，不进 git）
#   - app 的 DATABASE_URL 在这里写完整值（含同一密码，由 env_file 注入）
DATABASE_URL=postgresql://echomind:change_me_strong_password@postgres:5432/echomind_db?sslmode=disable
POSTGRES_PASSWORD=change_me_strong_password

# ===== Redis =====
# 生产建议给 Redis 加密码：REDIS_PASSWORD=xxx（并同步改 app 的 REDIS_URL）

# ===== 嵌入模型（本地 bge，路径由 compose 注入）=====
EMBEDDING_MODEL=/app/backend/data/models/bge-large-zh-v1.5

# ===== 沙箱镜像 digest 锁定（P1-C/P2，可选）=====
# 填后沙箱以 <image>@<digest> 拉取，防镜像 tag 被篡改
# 获取: docker inspect --format '{{index .RepoDigests 0}}' <image>
# SANDBOX_IMAGE_DIGEST=sha256:xxxx          # 裸镜像 python:3.12-slim
# SANDBOX_STD_IMAGE_DIGEST=sha256:xxxx      # 模板镜像 codemind-sandbox:std（预装 numpy/pandas）
# SANDBOX_IMAGE=codemind-sandbox:std        # 默认沙箱镜像（模板；可切回 python:3.12-slim）

# ===== 沙箱可选联网（P2，默认断网）=====
# 默认 none（断网，安全卖点）；proxy = 可选联网：沙箱走白名单代理，只放行白名单域名
# 代理启动：python -m sandbox.proxy
# SANDBOX_NETWORK=none
# PROXY_WHITELIST_DOMAINS=api.deepseek.com,pypi.org,github.com
# PROXY_PORT=8888

# ===== 限流 / 成本 / 并发 / 记忆（P2）=====
# 限流：Redis 滑动窗口（默认 60s 窗口）
# RATE_LIMIT_WINDOW=60
# RATE_LIMIT_IP_MAX=120
# RATE_LIMIT_USER_MAX=30
# 成本：每用户每日 token 预算（超限熔断返回 429）
# COST_DAILY_BUDGET_PER_USER=100000
# 沙箱并发：全局 / 每用户 / 槽位 TTL（Redis 分布式信号量）
# SANDBOX_MAX_GLOBAL=4
# SANDBOX_MAX_PER_USER=2
# SANDBOX_SLOT_TTL=60
# 记忆访问时间节流（秒）：同一记忆在窗口内只 upsert 一次（降写放大）
# MEM_TOUCH_THROTTLE=60
